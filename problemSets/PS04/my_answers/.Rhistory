#Creating Data Frame EXAMPLE:
l <- list(x = 1:5, y = letters[1:5], z = rep(c(TRUE, FALSE), length.out = 5))
#Subsetting Data Frame
#if you subset w/ a single vector it behaves as a list
#if you subset w/ two vectors it behaves as a matrix
#EXAMPLE like a list
df[[c("z")]]
#adding colums EXAMPLE
rand <- rnorm(5)
df <- cbind(df, rand)
#adding rows EXAMPLE
r <- list(6, letters[6], FALSE, rnorm(1))
#Revisiting assignment
#in R binding another name to an object does not create a copy of the object, instead it creates another name for the same object
df1 <- data.frame(A = c(1, 3, 5), B = c(2, 4, 6))
df2 <- df1
#Copy-on-modify Semantics
#when an object is modified it creates a copy of the object and modifies the copy (original is unchanged)
df2$C <- c(7, 8, 9)
df1
df2
#Data Frame Alternatives
#tibble (tibble package) provides features enhancing user experience
#data.table provides speed
library("data.table")
dt <- data.table::data.table(
x = 1:4
y = c("a", "b", "c", "d")
dt <- data.table::data.table(
x = 1:4
y = c("a", "b", "c", "d")
#EXAMPLE
dt[,z]
dt[,.(z)]
#Tibble
#designed to be backward compatible wth base R data frames
#console printing is cleaner
#have colums that themselves contain lists as elements
#seamless integration w/ the tidyverse ecosystem
library("tibble")
tb <-  tibble::tibble(
x = 1:4,
y = c("a", "b", "c", "d"),
z = c(TRUE, FALSE, FALSE, TRUE)
)
#EXAMPLE
str(tb)
#Its principal functions are:
#filter() - subset rows from data
#mutate() - add new/modify existing variables
#rename() - rename existing variable
#select() - subset columns from data
#arrange() - order data by some variable
#For data summary:
#group_by() - aggregate data by some variable
#summarise() - create a summary of aggregated variables
#dplyr: subsetting
dplyr::filter(tb, y == 'b', z == FALSE)
# A tibble: 1 × 3
#     x y     z
#. <int> <chr> <lgl>
#    2 b     FALSE
dplyr::select(tb, x, z)
# A tibble: 4 × 2
#     x z
#  <int> <lgl>
#    1 TRUE
#    2 FALSE
#    3 FALSE
#    4 TRUE
#dplyr: Modifying columns
#data is not modified in-place and you need to reassign the results
tb <- dplyr::mutate(tb, rand = rnorm(4))
# A tibble: 4 × 2
#     x z
#  <int> <lgl>
#    1 TRUE
#    2 FALSE
#    3 FALSE
#    4 TRUE
#dplyr: Modifying columns
#data is not modified in-place and you need to reassign the results
tb <- dplyr::mutate(tb, rand = rnorm(4))
#%>% Operator
#allows to chain data transformations without creating intermediate variables
#EXAMPLE
tb <- tb %>%
#%>% Operator
#allows to chain data transformations without creating intermediate variables
#EXAMPLE
tb <- tb %>%
tb
tb <- tb %>%
dplyr::mutate(random2 = rnorm(4)) %>%
dplyr::filter(z == FALSE)
tb2 <- tibble::tibble(
country = c("Afghanistan", "Brazil"),
`1999` = c(745, 2666),
`2000` = c(37737, 80488)
)
tb2
tb2 <- tb2 %>%
#Note that pivoting functions come 'tidyr' package
tidyr::pivot_longer(
cols = c("1999", "2000"),
names_to = "year",
values_to = "cases"
)
tb2
# A tibble: 4 × 3
#country     year  cases
#<chr>       <chr> <dbl>
#Afghanistan 1999    745
#Afghanistan 2000  37737
#Brazil      1999   2666
#Brazil      2000  80488
tb2 <- tb2 %>%
tidyr::pivot_wider(names_from = "year", values_from = "cases")
tb2
